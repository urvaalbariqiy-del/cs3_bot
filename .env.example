# @BotFather'dan olingan bot tokeni
BOT_TOKEN=123456789:AAExample-Token-Here

# Admin(lar)ning Telegram user_id raqamlari, vergul bilan ajratilgan
# O'z ID'ingizni bilish uchun @userinfobot ga /start yozing
ADMIN_IDS=111111111,222222222

# Ma'lumotlar bazasi fayli (o'zgartirish shart emas)
DB_PATH=bot_database.db

# Obuna tugashidan necha soat oldin eslatma yuborilsin
REMINDER_HOURS_BEFORE=24
