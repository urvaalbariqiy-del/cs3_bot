# --- Telegram ---
# Bot faqat saytga ulanish uchun kerak: odam /start bosadi, tamom.
BOT_TOKEN=
BOT_USERNAME=            # @ belgisisiz, masalan: cryptospot3_bot
ADMIN_IDS=               # vergul bilan: 5079059516,7255169991

# --- Rejim ---
# true  = hamma bo'lim hammaga ochiq, to'lov qabul qilinmaydi,
#         tariflar saytda "tez orada" deb ko'rsatiladi (birinchi bosqich)
# false = obuna va to'lov to'liq ishlaydi (keyinchalik)
FREE_MODE=true

# --- Baza ---
DB_PATH=bot_database.db

# --- Sayt / API ---
API_SECRET=              # bo'sh qoldirsangiz tokendan hosil qilinadi
CORS_ORIGINS=*           # ishlab chiqarishda: https://cryptospot3.uz
API_HOST=0.0.0.0
API_PORT=8000

# --- Boshqa ---
REMINDER_HOURS_BEFORE=24
LOGIN_TOKEN_TTL_SECONDS=300
